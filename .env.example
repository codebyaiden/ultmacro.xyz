# server-only Strategy Network settings. Never commit real values.
DATABASE_URL=postgresql://ultmacro_strategy:change-me@127.0.0.1:5432/ultmacro_strategy
STRATEGY_STORAGE_ROOT=/var/lib/ultmacro
PORT=3000
HOST=127.0.0.1
# Public poll origin; never derived from client-supplied proxy headers.
POLL_PUBLIC_ORIGIN=https://ultmacro.xyz
STRATEGY_HASH_SECRET=
STRATEGY_ADMIN_PASSWORD_HASH=

# Web Push keys are server-only. Generate once and keep the private key out of Git.
DASHBOARD_VAPID_PUBLIC_KEY=
DASHBOARD_VAPID_PRIVATE_KEY=
DASHBOARD_VAPID_SUBJECT=
# Private staff #bug-reports Discord webhook. Configure only on the backend/VPS.
# Never expose this in browser code, commits, or public environment variables.
UM_BUG_REPORT_WEBHOOK=
