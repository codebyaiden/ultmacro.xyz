{
  "name": "ultmacro-strategy-network",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "build:dashboard-devices": "esbuild src/dashboard-devices.js --bundle --minify --format=iife --outfile=assets/dashboard-devices.bundle.js",
    "test": "node --test tests/*.test.mjs tests/strategy-network.test.js",
    "migrate": "node scripts/migrate.mjs",
    "seed": "node scripts/seed-strategies.mjs",
    "hash-admin-password": "node scripts/hash-admin-password.mjs",
    "wiki:check": "node scripts/check-wiki-content.mjs",
    "wiki:release-audit": "node scripts/audit-release-zip.mjs",
    "wiki:build-retrieval": "node scripts/build-wiki-retrieval.mjs",
    "wiki:check-retrieval": "node scripts/build-wiki-retrieval.mjs --check",
    "wiki:deployment-check": "node scripts/check-wiki-deployment.mjs"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
